; Engine configuration file.
; Hexvault - Godot 4.7.2-stable

config_version=5

[application]

config/name="Hexvault"
config/description="A pixel-art arcane-tech dungeon roguelite."
config/version="0.9.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon/icon.png"
boot_splash/bg_color=Color(0.0784, 0.0627, 0.1176, 1)
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="Hexvault"

[autoload]

Events="*res://scripts/autoload/events.gd"
Db="*res://scripts/autoload/db.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
Profile="*res://scripts/autoload/profile.gd"
Settings="*res://scripts/autoload/settings.gd"
Controls="*res://scripts/autoload/controls.gd"
SpriteLib="*res://scripts/autoload/sprite_lib.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=4

[gui]

theme/default_font_antialiasing=0

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="player_hurtbox"
2d_physics/layer_5="enemy_hurtbox"
2d_physics/layer_6="pickup"
2d_physics/layer_7="interact"
2d_physics/layer_8="breakable"

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=0.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0431, 0.0353, 0.0706, 1)
textures/vram_compression/import_etc2_astc=true
