class_name SpriteManifest
extends RefCounted
## Static access to assets/manifest.json (generated by tools/artgen/build.py).

const PATH: String = "res://assets/manifest.json"

static var _data: Dictionary = {}


static func data() -> Dictionary:
	if _data.is_empty():
		var text: String = FileAccess.get_file_as_string(PATH)
		var parsed: Variant = JSON.parse_string(text)
		_data = parsed if parsed is Dictionary else {"sprites": {}, "images": {}}
	return _data


static func sprites() -> Dictionary:
	var s: Variant = data().get("sprites", {})
	return s if s is Dictionary else {}


static func images() -> Dictionary:
	var s: Variant = data().get("images", {})
	return s if s is Dictionary else {}


static func has_sprite(key: String) -> bool:
	return sprites().has(key)


static func has_image(key: String) -> bool:
	return images().has(key)
